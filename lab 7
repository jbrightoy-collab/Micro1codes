// Sets up the EUSART communication parameters [cite: 250]
void setup_comms(void)  {
    RX_PIN = 1; // Configure RC5 as input (EUSART RX) [cite: 250, 218]
    TX_PIN = 1; // Configure RC4 as input (used by EUSART TX) [cite: 250, 218] (EUSART module overrides TRIS) [cite: 46]
    SPBRG = DIVIDER; // Set baud rate generator register [cite: 250, 218]
    RCSTA = (NINE_BITS | 0x90); // Enable serial port and continuous receive, 8-bit mode [cite: 251, 42, 1508] (0x90 = SPEN | CREN)
    TXSTA = (SPEED | NINE_BITS | 0x20); // Enable transmit, 8-bit mode, async, high speed [cite: 251, 41, 1815] (0x20 = TXEN) (SPEED is 0x4 -> BRGH=1) [cite: 218]
    // Note: Individual bit settings below are redundant if registers are set as above
    TXEN = 1; // Enable transmission [cite: 251, 39]
    SYNC = 0; // Asynchronous mode [cite: 251, 40]
    SPEN = 1; // Enable serial port [cite: 252, 40]
    BRGH = 1; // High speed baud rate [cite: 252]
}

// Function required by printf to output characters through EUSART [cite: 50]
void putch(char bVal) {
    while(!TXIF) /* set when register is empty */ // Wait for transmit buffer to be empty [cite: 252]
        continue;
    TXREG = bVal; // Load character into transmit register [cite: 253]
}

// Function to get a character from EUSART (blocking) [cite: 253]
int getch() {
    while(!RCIF) /* set when register is not empty */ // Wait for receive buffer to be full [cite: 253]
        continue;
    return RCREG; // Return received character [cite: 254]
}

// Function to get a character from EUSART and echo it back (blocking) [cite: 254]
int getche(void) {
    unsigned char c;
    putch(c = getch()); // Get char and then send it back [cite: 255]
    return c;
}

// Configures oscillator and I/O pins [cite: 255]
void pinConfig(void)  {
    OSCCON = 0x6A; /* b6..4 = 110 = 4MHz */ // Set internal oscillator frequency [cite: 256, 1179] (Note: 0x6A -> IRCF=1101 -> 4MHz)
    TXCKSEL = 1; // Remap EUSART TX to RC4 for PIC16F1829 (APFCON0 bit 2)
    RXDTSEL = 1; // Remap EUSART RX to RC5 for PIC16F1829 (APFCON0 bit 7)

    // Configure PORTA
    TRISA = 0x10; // RA4 input, RA3 input only, RA5, RA2, RA1, RA0 outputs [cite: 259] (RA5, RA2 for LEDs)
    ANSELA = 0x10; // RA4 analog, others digital [cite: 259]

    // Configure PORTC
    TRISC = 0x0C; /* set RC3, RC2 as input */ // RC5(RX), RC4(TX) setup by EUSART & APFCON [cite: 259, 46, 258]
    ANSELC = 0x0C; /* RC3, RC2 are analog */ // For sensors in Part B [cite: 260, 92]

    // Configure PORTB
    TRISB = 0xF0; // RB7-RB4 inputs, RB3-RB0 outputs [cite: 260] (RB5 for Pot)
    ANSELB = 0xF0; // RB7-RB4 analog, RB3-RB0 digital [cite: 260] (RB5 for Pot)

    INTCON = 0; // Disable all interrupts [cite: 261]
}

